# Copier en .env et remplir. Ne jamais commiter .env.

# --- Général ---
ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO

# --- Base de données ---
# Local (docker compose) : postgresql+psycopg://maintenance:maintenance@localhost:5432/maintenance
# Railway : référencer ${{Postgres.DATABASE_URL}} (postgres:// est converti automatiquement)
DATABASE_URL=postgresql+psycopg://maintenance:maintenance@localhost:5432/maintenance

# --- Agent Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=8000
AGENT_MAX_ITERATIONS=8

# --- Authentification ---
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Sel HMAC des clés API machine. Le changer invalide toutes les clés existantes.
API_KEY_SALT=

# --- HTTP ---
# Origines autorisées (séparées par des virgules), ex. le domaine du frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_ANALYSE=10/minute

# --- Email ---
EMAIL_PROVIDER=console          # sendgrid | resend | console
EMAIL_FROM=alertes@votre-domaine.be   # doit être une Sender Identity vérifiée (SendGrid) ou un domaine vérifié (Resend)
EMAIL_FROM_NAME=MaintenanceAI
SENDGRID_API_KEY=               # clé avec la permission « Mail Send »
RESEND_API_KEY=
